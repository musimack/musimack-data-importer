FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app
RUN addgroup --system musimack && adduser --system --ingroup musimack --no-create-home musimack

COPY requirements-p2-3e.txt ./
RUN pip install --no-cache-dir --disable-pip-version-check -r requirements-p2-3e.txt

COPY src ./src
RUN python -c "import src.cloud_ingestion.p2_3e_pilot"

USER musimack
ENTRYPOINT ["python", "-m", "src.cloud_ingestion.p2_3e_pilot"]
